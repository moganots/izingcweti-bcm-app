# ============================================
# BCM Mobile Application - Environment Config
# ============================================

# --------------------------------------------
# Application Configuration
# --------------------------------------------
VITE_APP_NAME="Izingcweti BCM Mobile App"
VITE_APP_VERSION=25.0514.1
VITE_APP_DESCRIPTION="Business Continuity Management Mobile Application"

# --------------------------------------------
# Environment
# Options: Local, Development, Staging, SIT, UAT, Production, DR
# Set to "Development" to enable debug features and stress test button
# --------------------------------------------
VITE_ENV_NAME=UAT
VITE_NODE_ENV=uat

# --------------------------------------------
# API Configuration
# --------------------------------------------
VITE_API_BASE_URL=http://localhost:9810/api
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000

# --------------------------------------------
# Authentication
# --------------------------------------------
VITE_AUTH_TOKEN_KEY=bcm_auth_token
VITE_AUTH_REFRESH_KEY=bcm_refresh_token
VITE_AUTH_USER_KEY=bcm_user
VITE_AUTH_REMEMBER_ME_KEY=bcm_remembered_email

# --------------------------------------------
# Sync Configuration
# --------------------------------------------
VITE_SYNC_INTERVAL_MINUTES=5
VITE_SYNC_MAX_RETRIES=5
VITE_SYNC_BATCH_SIZE=50
VITE_SYNC_ENABLED=true

# --------------------------------------------
# Cache Configuration
# --------------------------------------------
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL_SECONDS=3600
VITE_CACHE_MAX_SIZE_MB=50

# --------------------------------------------
# Logging Configuration
# --------------------------------------------
VITE_LOG_LEVEL=debug
VITE_LOG_ENABLE_CONSOLE=true
VITE_LOG_ENABLE_REMOTE=false

# --------------------------------------------
# Feature Flags
# --------------------------------------------
VITE_FEATURE_OFFLINE_MODE=true
VITE_FEATURE_BIOMETRIC=false
VITE_FEATURE_PUSH_NOTIFICATIONS=true
VITE_FEATURE_DARK_MODE=true
VITE_FEATURE_MULTI_TENANT=true

# --------------------------------------------
# Sentry Error Tracking (Optional)
# --------------------------------------------
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# VITE_SENTRY_ENVIRONMENT=development

# --------------------------------------------
# Analytics (Optional)
# --------------------------------------------
# VITE_ANALYTICS_ID=UA-XXXXXXXXX-X
# VITE_ANALYTICS_ENABLED=false