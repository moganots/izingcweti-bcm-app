{
  "name": "izingcweti-bcm-app",
  "productName": "Izingcweti - BCM App",
  "description": "Izingcweti Business Continuity Management Mobile App",
  "version": "26.0520.1",
  "company": {
    "name": "Izingcweti",
    "contact": {
      "email": {
        "info": "info@bcm.izingcweti.co.za",
        "admin": "admin@bcm.izingcweti.co.za",
        "support": "support@bcm.izingcweti.co.za"
      },
      "phone": "+27 (0) ** **** ****"
    }
  },
  "author": "thabang.mogano@gmail.com",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "quasar clean && rm -rf node_modules android dist logs package-lock.json yarn.lock deploy*.* izingcweti-bcm-app*.* izingcweti-bcm-app*.* izingcweti-bcm-app*.* izingcweti_bcm_app*.* izingcweti_bcm_app*.* izingcweti_bcm_app*.* izingcweti-app*.* izingcweti_app*.* bcm-app*.* bcm_app*.* izingcweti_bcm_app*.* dev-app*.* uat-app*.* sit-app*.* stg-app*.* dr-app*.* prod-app*.* dev_app*.* uat_app*.* sit_app*.* stg_app*.* dr_app*.* prod_app*.* devapp*.* uatapp*.* sitapp*.* stgapp*.* drapp*.* prodapp*.*",
    "lint": "eslint --ext .js,.ts,.vue ./",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "typecheck": "vue-tsc --noEmit",
    "dev": "quasar dev -m capacitor -T android",
    "build": "quasar build -m capacitor -T android --skip-pkg",
    "build:android:dev": "quasar build -m capacitor -T android",
    "build:android:qa": "quasar build -m capacitor -T android",
    "build:android:prod": "quasar build -m capacitor -T android",
    "capacitor:sync": "npx cap sync",
    "capacitor:copy": "npx cap copy",
    "capacitor:update": "npx cap update",
    "capacitor:open:ios": "npx cap open ios",
    "capacitor:open:android": "npx cap open android",
    "capacitor:add:ios": "npx cap add ios",
    "capacitor:add:android": "npx cap add android",
    "generate-keystore": "npx tsx keystore-generator.ts",
    "build-debug-apk": "npx tsx build-apk.ts debug",
    "build-release-apk": "npx tsx build-apk.ts release",
    "build-release-apk-qa": "npx tsx build-apk.ts release qa",
    "build-release-apk-prod": "npx tsx build-apk.ts release prod",
    "clean:build": "yarn clean && yarn && yarn build",
    "sync:run:android:app": "npx cap add android && npx cap sync android && npx cap run android",
    "clean:build:web": "cp -f .env_files/.env.local .env && yarn clean && yarn install && yarn build",
    "dev:chrome": "cp -f .env_files/.env.local .env && quasar dev -m spa --open --browser chrome",
    "build:serve": "cp -f .env_files/.env.local .env && yarn build && npx serve dist/spa"
  },
  "dependencies": {
    "@capacitor/android": "^5.7.8",
    "@capacitor/app": "^5.0.8",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^5.7.0",
    "@capacitor/core": "^5.7.8",
    "@capacitor/device": "^8.0.2",
    "@capacitor/filesystem": "^5.2.2",
    "@capacitor/geolocation": "^5.0.8",
    "@capacitor/ios": "^5.7.0",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/local-notifications": "^5.0.7",
    "@capacitor/network": "^5.0.7",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.4",
    "@capacitor/splash-screen": "^5.0.8",
    "@capacitor/status-bar": "^5.0.8",
    "@capacitor/storage": "^1.2.5",
    "@quasar/extras": "^1.18.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "axios": "^1.16.1",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.2",
    "dexie-export-import": "^4.4.0",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^3.0.4",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^4.7.1",
    "quasar": "^2.19.3",
    "signature_pad": "^5.1.3",
    "uuid": "^11.1.1",
    "vite": "^8.0.13",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.2",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@quasar/app-vite": "^2.2.0",
    "@types/node": "^12.20.21",
    "@typescript-eslint/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^5.10.0",
    "autoprefixer": "^10.4.3",
    "eslint": "^8.10.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-vue": "^9.0.0",
    "prettier": "^2.5.1",
    "tsx": "^4.6.2",
    "typescript": "^5.8.3",
    "vue-tsc": "^2.2.10"
  }
}
